              <zone h='34000' id='5' type-v2='layout-basic' w='98666' x='667' y='800'>
                <zone forceUpdate='true' h='2764' id='1' type-v2='text' w='98666' x='667' y='800'>
                  <formatted-text>
                    <run fontalignment='1' fontsize='12'>ANALYST-STATISTIK-MILESTONE1</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
